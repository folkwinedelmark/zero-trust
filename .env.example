VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Durate in ms — default app: ACTION 45000 · TRACE 12000 · KICK 10000 · EXTRACT 300000
# GDD produzione: 300000 / 120000 / 60000 / 300000
# VITE_TIME_ACTION_MS=45000
# VITE_TIME_TRACE_MS=12000
# VITE_TIME_KICK_MS=10000
# VITE_TIME_EXTRACT_MS=300000

# God Mode UI (default: attiva). Imposta false per nasconderla.
# VITE_ENABLE_DEBUG=false
