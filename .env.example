VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Durate in ms — playtest 1 settimana (default in constants.js)
# Travel 30s · Action 20m · Trace 6m · Kick 3m · Deep Scan 3m · Extract 40m
# VITE_TIME_ACTION_MS=1200000
# VITE_TIME_TRACE_MS=360000
# VITE_TIME_KICK_MS=180000
# VITE_TIME_DEEP_SCAN_MS=180000
# VITE_TIME_EXTRACT_MS=2400000

# God Mode UI (default: attiva). Imposta false per nasconderla.
# VITE_ENABLE_DEBUG=false
